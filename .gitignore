# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
# Sin barra final a proposito: ahora `.next` es un symlink, no un directorio, y
# la regla `/.next/` solo tapaba directorios.
/.next
# El proyecto vive en ~/Desktop, que iCloud sincroniza. iCloud no sube nada
# que termine en `.nosync`, asi que `.next` es un symlink a esta carpeta y el
# build real cae afuera de la sincronizacion. Sin esto iCloud dejaba copias de
# conflicto ("routes-manifest 2.json") adentro de la salida del build, y dos de
# ellas eran .ts: rompian el typecheck con "Duplicate identifier".
/.next.nosync/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA: public/sw.js ya NO se ignora, es código fuente (ver public/sw.js).
# Solo se ignoran los restos que dejaba next-pwa.
**/public/sw.js.map
**/public/workbox-*.js
**/public/workbox-*.js.map
**/public/worker-*.js
**/public/worker-*.js.map

# herramientas locales
.claude/
.cursor/

IMPLEMENTATION_SUMMARY.md
.env*
